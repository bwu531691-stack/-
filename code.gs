function doGet() {
  return HtmlService.createHtmlOutputFromFile('index');
}

function getIdeologyData() {
  return IDEOLOGY_DATA;
}

function saveIdeology(data) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName("研究紀錄");
  if (!sheet) {
    sheet = ss.insertSheet("研究紀錄");
    sheet.appendRow(["時間", "主類別", "子分支", "筆記"]);
  }
  sheet.appendRow([new Date(), data.mainType, data.subType, data.notes]);
  return "資料已成功寫入試算表";
}

function getSavedEntries() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("研究紀錄");
  if (!sheet) return [];
  const values = sheet.getDataRange().getValues();
  const headers = values.shift();
  return values.map(row => ({
    timestamp: row[0],
    mainType: row[1],
    subType: row[2],
    notes: row[3]
  }));
}
